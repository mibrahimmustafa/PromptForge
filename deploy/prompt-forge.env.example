# PromptForge - production environment.
#
#   cp deploy/prompt-forge.env.example deploy/prompt-forge.env
#   chmod 600 deploy/prompt-forge.env
#
# Never commit the filled-in file. The container reads it via env_file.

# ------------------------------------------------------------------ HTTP
SERVER_PORT=8080

# ------------------------------------------------------------------ LLM
# auto | anthropic | openai | gemini
# "auto" uses whichever provider has a key, preferring anthropic > openai > gemini.
LLM_PROVIDER=auto

# Leave a key empty to disable that provider. With no key at all the app runs
# entirely on the local rule engine and never makes an outbound call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------ JVM
# MaxRAMPercentage lets the JVM size its heap from the container limit.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
